#!/bin/bash
set -euo pipefail

if (( $# > 1 )); then
    echo "Usage: $0 [pid]" >&2
    exit 1
fi

case "$(uname -s)" in
    Darwin) debugger=(xcrun lldb) ;;
    *) debugger=(lldb) ;;
esac

pid=${1:-}
if [[ -z "$pid" ]]; then
    processes=()
    while read -r candidate executable; do
        if [[ "${executable##*/}" == java ]]; then
            processes+=("$candidate $(ps -p "$candidate" -o args=)")
        fi
    done < <(ps -axo pid=,comm=)

    if (( ${#processes[@]} == 0 )); then
        echo "No running Java processes found." >&2
        exit 1
    fi

    PS3="Select a Java process: "
    select process in "${processes[@]}"; do
        if [[ -n "$process" ]]; then
            pid=${process%% *}
            break
        fi
        echo "Invalid selection." >&2
    done
fi

if [[ ! "$pid" =~ ^[1-9][0-9]*$ ]]; then
    echo "Expected a positive numeric PID." >&2
    exit 1
fi

IFS= read -r library <<'LIBRARY_PATH'
$<TARGET_FILE:NoHitDelay>
LIBRARY_PATH
if [[ ! -f "$library" ]]; then
    echo "Library not found: $library. Build NoHitDelay first." >&2
    exit 1
fi

# Quote the path for LLDB's command parser as well as the shell.
lldb_path=${library//\\/\\\\}
lldb_path=${lldb_path//\"/\\\"}
exec "${debugger[@]}" --no-lldbinit --batch \
    -o "process attach --pid $pid" \
    -o "process load \"$lldb_path\"" \
    -o 'process detach' \
    -o quit
